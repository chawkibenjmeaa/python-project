# Copy this file to .env and fill it in.

# Required: OpenAI key for the agents
OPENAI_API_KEY=

# Optional: which GPT model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: free key from https://finnhub.io for news. Without it the memo has no news.
FINNHUB_API_KEY=

# Optional: SEC asks for a name and email when you download filings
# EDGAR_IDENTITY=Your Name your.email@example.com
